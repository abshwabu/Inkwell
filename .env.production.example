APP_NAME=Inkwell
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://inkwell.example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# SQLite Single-File Database (WAL Mode & Foreign Keys enforced)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/inkwell/database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=inkwell_cache_

FILESYSTEM_DISK=public

# Mail configuration (SMTP, Postmark, Resend, or SES)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@inkwell.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional features
VITE_APP_NAME="${APP_NAME}"
